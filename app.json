{
  "expo": {
    "name": "Fix-Flow",
    "slug": "fixflow",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1e3c72"
    },
    "assetBundlePatterns": ["**/*"],
    "notification": {
      "icon": "./assets/icon.png",
      "color": "#1e3c72",
      "iosDisplayInForeground": true,
      "androidMode": "default"
    },
    "android": {
      "package": "com.ongwediva.waterreporter",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET",
        "NOTIFICATIONS"
      ],
      "googleServicesFile": "./android/app/google-services.json"
    },
    "ios": {
      "bundleIdentifier": "com.ongwediva.waterreporter",
      "googleServicesFile": "./ios/GoogleService-Info.plist",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "plugins": [
      ["expo-location", {
        "locationAlwaysAndWhenInUsePermission": "Allow Fix-Flow to verify your location."
      }],
      ["expo-image-picker", {
        "cameraPermission": "Allow Fix-Flow to take photos and videos."
      }],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging"
    ]
  }
}