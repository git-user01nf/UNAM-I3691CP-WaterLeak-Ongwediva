{
  "expo": {
    "name": "Fix-Flow",
    "slug": "fixflow",
    "version": "1.0.0",
"description": "Fix-Flow: Water leak reporting app for Ongwediva infrastructure management.",
"owner": "git-user01nf",
"primaryColor": "#1e3c72",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["*/"],
    "android": {
      "package": "com.fixflow.app",
"versionCode": 1,
"compileSdkVersion": 34,
"targetSdkVersion": 34,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
"ios": {
  "supportsTablet": true,
  "bundleIdentifier": "com.fixflow.app"
},
"web": {
  "favicon": "./assets/favicon.png",
  "bundler": "metro"
},
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET"
        "CAMERA",
"RECORD_AUDIO",
"ACCESS_FINE_LOCATION",
"ACCESS_COARSE_LOCATION",
"READ_EXTERNAL_STORAGE",
"WRITE_EXTERNAL_STORAGE",
"INTERNET",
"VIBRATE",
"RECEIVE_BOOT_COMPLETED"
      ]
    },
    "plugins": [
      "expo-av",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Fix-Flow to verify your location."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Fix-Flow to take photos and videos."
        }
      ]
    ]
  }
}