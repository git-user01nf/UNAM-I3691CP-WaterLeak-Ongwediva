{
  "expo": {
    "name": "Fix-Flow",
    "slug": "ongwediva-water-reporter",
    "version": "1.0.0",
    "orientation": "portrait",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.ongwediva.waterreporter",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Fix-Flow to verify your location."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Fix-Flow to take photos."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e4b4338d-7b70-46f0-83b9-35edb358b41f"
      }
    }
  }
}
