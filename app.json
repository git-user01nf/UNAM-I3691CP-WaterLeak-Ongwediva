{
  "expo": {
    "name": "Fix-Flow",
    "slug": "fixflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1e3c72"
    },
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.fixflow.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1e3c72"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET"
      ]
    },
    "plugins": [
      "expo-av",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Fix-Flow to verify your location."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Fix-Flow to take photos and videos."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0d3b3e1b-23e2-4af8-9aa1-f099f9931e5a"
      }
    }
  }
}